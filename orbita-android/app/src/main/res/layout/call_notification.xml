<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp">
 <TextView android:id="@+id/call_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@android:color/secondary_text_light" android:textSize="13sp" android:paddingBottom="6dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
  <Button android:id="@+id/call_mic" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Мут" android:textSize="11sp" android:textAllCaps="false" android:padding="0dp"/>
  <Button android:id="@+id/call_sound" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Звук" android:textSize="11sp" android:textAllCaps="false" android:padding="0dp"/>
  <Button android:id="@+id/call_both" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Оба" android:textSize="11sp" android:textAllCaps="false" android:padding="0dp"/>
  <Button android:id="@+id/call_leave" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Выйти" android:textSize="11sp" android:textAllCaps="false" android:padding="0dp"/>
 </LinearLayout>
</LinearLayout>
